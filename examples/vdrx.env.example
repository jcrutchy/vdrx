# /etc/vdrx/vdrx.env      sudo install -m 600 -o root -g root vdrx.env.example /etc/vdrx/vdrx.env
# systemd EnvironmentFile syntax: NAME=value, no quotes, no "export".

# REQUIRED - the web terminal's login. vdrx refuses to start without it.
# Make it long and random, e.g.:   openssl rand -hex 24
JOBS_WS_TOKEN=change-me-to-a-long-random-string

# Optional (each has a default in vdrx.conf):
#WWW_ROOT=/mnt/www            # folder that CONTAINS the application folder
#VDRX_HTTP_PORT=8080
#VDRX_WS_PORT=8082
#VDRX_MAX_JOBS=4              # jobs allowed to run at once (0 = no limit)
#PHP_BIN=/usr/bin/php
#PHP_CGI_BIN=/usr/bin/php-cgi
#JOBS_WS_VIEW_TOKEN=          # for the read-only "viewer" profile (also set enabled:true in vdrx.conf)
