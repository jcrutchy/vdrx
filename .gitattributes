# Normalize line endings in the repo (LF) regardless of which platform an
# editor checked them out or saved them on. Several .pas files had stray CR
# bytes mixed into otherwise-LF content before this was added - almost
# certainly from editing on Windows against a checkout with no .gitattributes
# to pin the convention, which also makes `git diff`/`tr -d '\r'` workarounds
# unnecessary on Unix going forward.
* text=auto eol=lf

*.pas text eol=lf
*.pp text eol=lf
*.lpr text eol=lf
*.lpi text eol=lf
*.lpk text eol=lf
*.md text eol=lf
*.conf text eol=lf
*.json text eol=lf
*.php text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.tpl text eol=lf

*.ico binary
*.png binary
*.exe binary
